# Copy this file to .env.local and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app config.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Set to "true" to use mock prices instead of fetching from PSX (useful for UI development).
VITE_USE_MOCK_PRICES=false

# Worker URL: http://localhost:8787 for local Worker testing; deployed URL for production.
# Leave empty to reach the local Worker through Vite's /api proxy.
# Default worker:dev mode tries DPS first, then Sarmaaya if DPS fails.
# Start the alternate-source test with: npm run worker:dev:sarmaaya
VITE_PSX_PROXY_URL=
