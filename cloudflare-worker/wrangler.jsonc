{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "dps-psx-proxy",
  "main": "psx-proxy.js",
  "compatibility_date": "2026-09-07",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ALLOWED_ORIGINS": "https://zainzahid.github.io",
    "PRICE_SOURCE": "auto"
  },
  "ratelimits": [
    {
      "name": "PRICE_RATE_LIMITER",
      "namespace_id": "70907001",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "GLOBAL_RATE_LIMITER",
      "namespace_id": "70907002",
      "simple": { "limit": 600, "period": 60 }
    }
  ],
  "observability": { "enabled": true }
}
